# Copy to .env.local for local dev. Both values are in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server only (api/ingest.js). Set these in Vercel, never in VITE_ variables: they must not reach the browser.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# OWNER_USER_ID=your-auth-user-uuid
# INGEST_TOKEN=a-long-random-token

# AI trainer (api/coach.js), also Vercel only:
# ANTHROPIC_API_KEY=sk-ant-...
# OWNER_EMAIL=you@example.com
# COACH_MODEL=claude-opus-5-5
